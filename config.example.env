# Copy to config.env (gitignored) and fill in. Shipped to the Pi as /etc/funstation.env.
FUN_HOST=funstation                      # ssh host for install.sh
FUN_USER=fun                             # login user on the Pi
JELLYFIN_URL=https://jellyfin.example.ts.net/
ROMS_DIR=/home/fun/roms                  # on the Pi
LOCAL_ROMS=                              # optional: folder on your computer copied to ROMS_DIR
